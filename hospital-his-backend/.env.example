# ---- Required ----
NODE_ENV=production
PORT=5001
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hospital_his?retryWrites=true&w=majority
# Long random string: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
# Comma-separated list of frontend origins (no trailing slash)
CORS_ORIGINS=https://your-app.vercel.app

# ---- AI features (optional) ----
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---- Email (optional) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
HOSPITAL_NAME=
HOSPITAL_EMAIL=
HOSPITAL_PHONE=
HOSPITAL_ADDRESS=

# ---- Companion services (optional) ----
AI_OCR_SERVICE_URL=
ML_REVENUE_SERVICE_URL=
ML_PREDICT_SERVICE_URL=
